/.vs
/Build
/build
/build-*/
*.user
.vscode
*.internal
/.cppbuild
/*.sln
# Emscripten build output includes a --preload-file bundle of whatever local
# gamedata path was passed to CMake at configure time. UT99/UE1 game data is
# commercial and must never be committed.
*.data

# Electron dependencies and local package output. Release artifacts belong in
# the workspace-level SurrealEngine/out and SurrealEngine/releases trees.
/electron-webxr/node_modules/
/electron-webxr/dist/

# Regenerated by every web/smoke_test_webgpu.py run - not a source artifact.
web/webgpu_smoke_screenshot.png

# Local BotBenchmark output is regenerated diagnostic data. Admissible
# benchmark evidence is written under the central QA tree.
/botbench-output/

# Local Python tool/test bytecode is generated, never evidence or source.
__pycache__/
*.py[cod]
