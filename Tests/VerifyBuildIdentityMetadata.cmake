if(NOT DEFINED HEADER OR NOT EXISTS "${HEADER}")
	message(FATAL_ERROR "missing generated build identity header")
endif()

file(READ "${HEADER}" BUILD_IDENTITY_HEADER)
foreach(FIELD AVAILABLE COMMIT TREE DIRTY)
	if(NOT BUILD_IDENTITY_HEADER MATCHES "SURREAL_BUILD_IDENTITY_${FIELD}")
		message(FATAL_ERROR "generated build identity header omits ${FIELD}")
	endif()
endforeach()

if(NOT BUILD_IDENTITY_HEADER MATCHES "#define SURREAL_BUILD_IDENTITY_AVAILABLE 1")
	message(FATAL_ERROR "Git checkout did not produce available build identity metadata")
endif()
if(NOT BUILD_IDENTITY_HEADER MATCHES "SURREAL_BUILD_IDENTITY_COMMIT \"[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\"")
	message(FATAL_ERROR "generated build identity commit is not a lowercase 40-hex ID")
endif()
if(NOT BUILD_IDENTITY_HEADER MATCHES "SURREAL_BUILD_IDENTITY_TREE \"[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\"")
	message(FATAL_ERROR "generated build identity tree is not a lowercase 40-hex ID")
endif()
